{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open",
  "main": "worker/index.ts",
  // Browser Run quick actions from the binding need 2026-03-24 or later.
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  // The UI is a static export of the Next.js app (npm run build:cf). Only /api/* runs the Worker.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PERSON_AGENT", "class_name": "PersonAgent" },
      { "name": "MARKET", "class_name": "MarketAgent" },
      // The service's daily budget: one object holds every counter.
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PersonAgent", "MarketAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Budget"] }
  ],
  // Per-address rate limits at the edge, before any agent wakes. Counted per Cloudflare location, so they're a
  // flood guard; the daily caps in the Budget object are the exact ones.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  // Cloudflare Browser Run, for the read-only page reader.
  "browser": { "binding": "BROWSER" },
  // Workers AI: an open model runs the agent when there's no Claude key. Calls are billed even from wrangler dev.
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "OPEN_PACE": "1"
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false
}
