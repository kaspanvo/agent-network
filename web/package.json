{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cf": "OPEN_EXPORT=1 next build",
    "dev:cf": "npm run build:cf && wrangler dev",
    "deploy": "npm run build:cf && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "sim": "vite-node src/sim/cli.ts --"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@cloudflare/playwright": "^1.4.0",
    "agents": "^0.34.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
